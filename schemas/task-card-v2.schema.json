{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mint.local/schemas/task-card-v2.schema.json",
  "type": "object",
  "required": ["schemaVersion", "kind", "requiredSkill", "skillVersion", "themeVersion", "reportId", "title", "sections", "taskCardHash"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "kind": { "const": "mint-ppt-task-card" },
    "requiredSkill": { "const": "mint-report-ppt" },
    "skillVersion": { "type": "string" }, "themeVersion": { "type": "string" },
    "reportId": { "type": "string" }, "title": { "type": "string" },
    "sections": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["sectionId", "title", "order", "owner", "outlineItems"] }
    },
    "taskCardHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
