{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mint.local/schemas/task-card-v2.schema.json",
  "type": "object",
  "required": ["schemaVersion", "kind", "requiredSkill", "skillVersion", "planningSchemaVersion", "slideIrVersion", "themeVersion", "allowAppendix", "reportId", "title", "sections", "taskCardHash"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "kind": { "const": "mint-ppt-task-card" },
    "requiredSkill": { "const": "mint-report-ppt" },
    "skillVersion": { "type": "string" },
    "planningSchemaVersion": { "const": "2.5" },
    "slideIrVersion": { "const": "1.5" },
    "presentationBrief":{"type":"object","properties":{"audience":{"type":"string"},"meetingContext":{"type":"string"},"communicationGoal":{"type":"string"},"visualTone":{"type":"string"},"language":{"type":"string"},"decisionFirst":{"type":"boolean"}},"additionalProperties":false},
    "workPackages":{"type":"array","items":{"type":"object","required":["workPackageId","owner","sectionIds"],"properties":{"workPackageId":{"type":"string"},"owner":{"type":"string"},"sectionIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}},"additionalProperties":false}},
    "allowAppendix": { "type": "boolean", "default": false },
    "themeVersion": { "type": "string" },
    "reportId": { "type": "string" }, "title": { "type": "string" },
    "sections": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["sectionId", "title", "order", "owner", "outlineItems"] }
    },
    "taskCardHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
