{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mint.local/schemas/slide-ir.schema.json",
  "title": "Mint Report Slide IR",
  "type": "object",
  "required": ["schemaVersion", "slideIrVersion", "planningSchemaVersion", "reportId", "slides"],
  "anyOf": [{"required":["sectionId"]},{"required":["sectionIds"]}],
  "properties": {
    "schemaVersion": { "const": "1.5" },
    "slideIrVersion": { "const": "1.5" },
    "planningSchemaVersion": { "const": "2.5" },
    "sectionIds": {"$ref":"#/$defs/refList"},
    "designRequirements": {"type":"array","items":{"$ref":"#/$defs/designRequirement"}},
    "reportId": { "type": "string", "minLength": 1 },
    "sectionId": { "type": "string", "minLength": 1 },
    "slides": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "designRequirement": {
      "type":"object","required":["id","scope","type","strength","requirement"],
      "properties":{"id":{"type":"string","minLength":1},"scope":{"enum":["slide","report"]},"slideId":{"type":"string"},"type":{"type":"string"},"strength":{"enum":["hard","soft"]},"requirement":{"type":"string","minLength":1},"targetId":{"type":"string"},"expectedText":{"type":"string"},"from":{"type":"string"},"to":{"type":"string"}},"additionalProperties":false
    },
    "slide": {
      "type": "object",
      "required": ["id", "role", "managementQuestion", "claim", "semanticIntent", "density", "evidenceRefs", "modules"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sectionId":{"type":"string"},
        "outlineItems":{"$ref":"#/$defs/refList"},
        "designRequirementRefs":{"$ref":"#/$defs/refList"},
        "designIntent":{"type":"object","properties":{"dominantMessage":{"type":"string"},"relationshipTypes":{"$ref":"#/$defs/refList"},"primaryCarrier":{"type":"string"},"focusObjects":{"$ref":"#/$defs/refList"},"focusMetrics":{"$ref":"#/$defs/refList"}},"additionalProperties":false},
        "visualNarrative":{"type":"object","required":["pattern","primaryCarrier","readingOrder"],"properties":{"pattern":{"type":"string"},"primaryCarrier":{"type":"string"},"readingOrder":{"$ref":"#/$defs/refList"}},"additionalProperties":false},
        "role": { "enum": ["cover", "section", "content", "appendix", "closing"] },
        "managementQuestion": { "type": "string" },
        "showManagementQuestion": { "type": "boolean", "default": false },
        "claim": { "type": "string", "minLength": 1 },
        "semanticIntent": { "type": "string", "minLength": 1 },
        "outlineItem": { "type": "string" },
        "storyCluster": { "type": "string" },
        "decisionUnit": { "type": "string" },
        "outlinePart": { "type": "integer", "minimum": 1 },
        "outlineSplit": {
          "type": "object",
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "naturalBoundary": { "type": "string", "minLength": 1 },
            "continuationOf": { "type": "string", "minLength": 1 }
          },
          "required": ["reason", "naturalBoundary", "continuationOf"],
          "additionalProperties": false
        },
        "independentDecision": { "type": "boolean", "default": false },
        "pageComposition": { "enum": ["standard", "evidence-rich", "dashboard", "banded-story", "strategy-map"] },
        "evidenceBundle": {
          "type": "object",
          "properties": {
            "contextRefs": { "$ref": "#/$defs/refList" },
            "kpiRefs": { "$ref": "#/$defs/refList" },
            "primaryEvidenceRefs": { "$ref": "#/$defs/refList" },
            "supportingEvidenceRefs": { "$ref": "#/$defs/refList" },
            "caseRefs": { "$ref": "#/$defs/refList" },
            "comparisonRefs": { "$ref": "#/$defs/refList" },
            "chartRefs": { "$ref": "#/$defs/refList" },
            "tableRefs": { "$ref": "#/$defs/refList" },
            "imageRefs": { "$ref": "#/$defs/refList" },
            "riskRefs": { "$ref": "#/$defs/refList" },
            "actionRefs": { "$ref": "#/$defs/refList" },
            "decisionRefs": { "$ref": "#/$defs/refList" },
            "boundaryRefs": { "$ref": "#/$defs/refList" },
            "explanationRefs": { "$ref": "#/$defs/refList" },
            "decisionUnit": { "type": "string" }
          },
          "additionalProperties": false
        },
        "narrative": {
          "type": "object",
          "properties": { "previous": { "type": "string" }, "transition": { "type": "string" }, "next": { "type": "string" } },
          "additionalProperties": false
        },
        "density": { "enum": ["focused", "standard", "dense"] },
        "allowIntentionalWhitespace": { "type": "boolean", "default": false },
        "geometry": { "type": ["string", "null"], "enum": [null, "hero", "single-primary", "primary-secondary", "balanced-columns", "grid", "sequence", "matrix", "network"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "content" } } },
          "then": { "required": ["outlineItem", "storyCluster", "decisionUnit", "evidenceBundle"] }
        }
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": ["type", "semanticRole"],
      "properties": {
        "id": { "type": "string" },
        "visualPriority":{"enum":["P0","P1","P2"]},
        "primitive":{"enum":["takeaway-band","status-chip","metric-badge","risk-strip","decision-strip"]},
        "preferredExpression":{"type":"object","required":["type","variant"],"properties":{"type":{"enum":["text","metric","chart","table","diagram","image","callout"]},"variant":{"type":"string"}},"additionalProperties":false},
        "type": { "enum": ["text", "metric", "chart", "table", "diagram", "image", "callout"] },
        "semanticRole": { "enum": ["context", "primaryEvidence", "supportingEvidence", "managementConclusion", "comparison", "progress", "risk", "action", "decision", "boundary"] },
        "title": { "type": "string" }, "text": { "type": "string" }, "value": {}, "unit": { "type": "string" },
        "dataRef": { "type": "string" }, "data": {}, "imagePath": { "type": "string" }, "alt": { "type": "string" },
        "compositionBand": { "enum": ["lead", "primary", "result"] },
        "tableRole": { "enum": ["primary", "supporting", "reference", "detail"] },
        "carrierPurpose": { "enum": ["primaryProof", "exactLookup", "implication", "boundary", "action", "context"] },
        "reinforcementReason": { "type": "string" },
        "visibleFacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceUnitId", "text"],
            "properties": { "sourceUnitId": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "dataShape": { "type": "object" }, "expression": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "refList": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
